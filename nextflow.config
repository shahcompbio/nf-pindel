manifest {
    name = "shahcompbio/nf-pindel"
    description = "cgpPindel tumour-normal indel calling in one task"
    mainScript = "main.nf"
}

// Resources for the one task. They sit under withName so the generic
// process.cpus/memory/time in isabl's base.config (passed with -config)
// cannot override them. The app sets cpus and memory_gb from its settings.
params.cpus = 16
params.memory_gb = 32

process {
    withName: 'PINDEL' {
        cpus = params.cpus
        memory = { "${params.memory_gb * task.attempt} GB" }
        time = { 48.h * task.attempt }
    }
}
