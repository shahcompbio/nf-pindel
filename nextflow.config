manifest {
    name = "shahcompbio/nf-pindel"
    description = "cgpPindel tumour-normal indel calling in one task"
    mainScript = "main.nf"
    version = "1.1.1"
}

// Resources for the one task. pindel.pl runs up to `cpus` contigs at once, and
// the WGS pair of Isabl analysis 607136 peaked at 112 GB with 16 cpus.
// They sit under withName so a generic process.cpus/memory/time in a -config
// file cannot override them.
params.cpus = 16
params.memory_gb = 160

process {
    withName: 'PINDEL' {
        cpus = params.cpus
        memory = { "${params.memory_gb * task.attempt} GB" }
        time = { 48.h * task.attempt }
        // retry once on the exit codes of a kill: out of memory, wall clock, preemption
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'terminate' }
        maxRetries = 1
    }
}

// Isabl registers these two reports from pipeline_info/.
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')}.html"
}
