/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------

    Published layout
    ----------------
    toil_pindel wrote cgpPindel's results straight into --outdir, and the
    downstream isabl_apps contract globs them from there:

        <outdir>/<tumour>_vs_<normal>.flagged.vcf.gz(.tbi)
        <outdir>/<tumour>_vs_<normal>_mt.bam(.bai)
        <outdir>/<tumour>_vs_<normal>_wt.bam(.bai)
        <outdir>/<tumour>_vs_<normal>.germline.bed

    Those names come from the BAM headers' SM tags, not the samplesheet, so they
    are published exactly as cgpPindel writes them. With --flat_publish the
    <patient>/ segment is dropped, matching a single-analysis toil_pindel run.
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'CGPPINDEL' {
        // -species, -assembly and -seqtype are read from the BAM header when not
        // given. toil_pindel always passed the first two and never passed
        // -seqtype, so cgpPindel ran in its WGS default regardless of the data;
        // params.seqtype makes that explicit and still defaults to WGS.
        ext.args = {
            [
                params.species ? "-species ${params.species}" : '',
                params.assembly ? "-assembly ${params.assembly}" : '',
                params.exclude ? "-exclude '${params.exclude}'" : '',
                params.seqtype ? "-seqtype ${params.seqtype}" : '',
            ].findAll { arg -> arg }.join(' ')
        }

        cpus   = { params.pindel_cpus   ?: 4     }
        memory = { params.pindel_memory ?: 30.GB }

        publishDir = [
            path: { params.flat_publish ? "${params.outdir}" : "${params.outdir}/${meta.patient}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/')[-1] },
        ]
    }
}
