/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------

    Published layout
    ----------------
    toil_pindel wrote cgpPindel's results straight into --outdir, and the
    downstream isabl_apps contract globs them from there:

        <outdir>/<tumour>_vs_<normal>.flagged.vcf.gz(.tbi)
        <outdir>/<tumour>_vs_<normal>_mt.bam(.bai)
        <outdir>/<tumour>_vs_<normal>_wt.bam(.bai)
        <outdir>/<tumour>_vs_<normal>.germline.bed

    Those names come from the BAM headers' SM tags, not the samplesheet, so they
    are published exactly as cgpPindel writes them. With --flat_publish the
    <patient>/ segment is dropped, matching a single-analysis toil_pindel run.
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // -species, -assembly and -seqtype are read from the BAM header when not
    // given. toil_pindel always passed the first two and never passed -seqtype,
    // so cgpPindel ran in its WGS default regardless of the data; params.seqtype
    // makes that explicit and still defaults to WGS. Applies to every stage,
    // since each is a separate pindel.pl invocation that re-validates them.
    withName: '.*CGPPINDEL.*' {
        ext.args = {
            [
                params.species ? "-species ${params.species}" : '',
                params.assembly ? "-assembly ${params.assembly}" : '',
                params.exclude ? "-exclude '${params.exclude}'" : '',
                params.seqtype ? "-seqtype ${params.seqtype}" : '',
            ].findAll { arg -> arg }.join(' ')
        }
    }

    // The scattered path: one task per contig on one core, matching the shape
    // toil_pindel requested. CGPPINDEL_INPUT gets 2 because cgpPindel caps that
    // stage at two work items regardless of -cpus.
    withName: '.*:CGPPINDEL_INPUT' {
        cpus   = 2
        memory = { params.pindel_memory ?: 8.GB }
        publishDir = [enabled: false]
    }

    withName: '.*:CGPPINDEL_CALL' {
        cpus   = 1
        memory = { params.pindel_memory ?: 8.GB }
        publishDir = [enabled: false]
    }

    withName: '.*:CGPPINDEL_MERGE_FLAG' {
        cpus   = 1
        memory = { params.pindel_memory ?: 8.GB }

        publishDir = [
            path: { params.flat_publish ? "${params.outdir}" : "${params.outdir}/${meta.patient}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/')[-1] },
        ]
    }

    withName: 'CGPPINDEL' {
        // A contig cannot be split, so the longest contig is the critical path
        // in both execution shapes. chr1 is ~8% of GRCh37, so this path only
        // matches the scattered one at roughly 13+ cores; 4 would be ~3x slower.
        cpus   = { params.pindel_cpus   ?: 16    }
        memory = { params.pindel_memory ?: 30.GB }

        publishDir = [
            path: { params.flat_publish ? "${params.outdir}" : "${params.outdir}/${meta.patient}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename.tokenize('/')[-1] },
        ]
    }
}
