/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The reference genome, flagging resources and BAMs this pipeline runs against
    are not public, so there is no hosted full-size test dataset. Point the
    inputs at a real cohort to exercise the pipeline at scale:

        nextflow run shahcompbio/nf-pindel \
            -profile test_full,<docker/singularity> \
            --input        /path/to/cohort.csv \
            --fasta        /path/to/genome.fasta \
            --simrep       /path/to/simpleRepeats.bed.gz \
            --genes        /path/to/gene_regions.bed.gz \
            --unmatched    /path/to/pindel_np.gff3.gz \
            --filter_rules /path/to/genomicRules.lst \
            --outdir       <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test. Supply --input, --fasta and the flagging resources.'

    // cgpPindel recommends at most 4 cores during its input stage.
    pindel_cpus   = 16
    pindel_memory = '30.GB'
}
