/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Ported from toil_pindel's tests/test_commands.py::test_pindel.

    Use as follows:
        nextflow run shahcompbio/nf-pindel -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

// nf-schema resolves samplesheet file-paths against the launch directory, which
// differs from projectDir under nf-test. Write a samplesheet with absolute paths
// at config evaluation time so the profile works from any launch directory.
params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal tumour/normal test dataset for cgpPindel'

    input = new File(System.getProperty('java.io.tmpdir'), 'nf-pindel-test.csv').tap { it.text = "patient,sample,status,bam,bai,bas\nTEST,normal,0,${projectDir}/tests/data/normal/normal.bam,${projectDir}/tests/data/normal/normal.bam.bai,${projectDir}/tests/data/normal/normal.bam.bas\nTEST,tumor,1,${projectDir}/tests/data/tumor/tumor.bam,${projectDir}/tests/data/tumor/tumor.bam.bai,${projectDir}/tests/data/tumor/tumor.bam.bas\n" }.absolutePath

    fasta = "${projectDir}/tests/data/reference/reference.fasta"
    fai   = "${projectDir}/tests/data/reference/reference.fasta.fai"

    simrep       = "${projectDir}/tests/data/pindel/simrep.bed.gz"
    genes        = "${projectDir}/tests/data/pindel/genes.bed.gz"
    unmatched    = "${projectDir}/tests/data/pindel/unmatched.vcf.gz"
    filter_rules = "${projectDir}/tests/data/pindel/filter.lst"

    species  = 'HUMAN'
    assembly = 'GRCH37D5'
    exclude  = 'NC_007605,hs37d5,GL%'

    pindel_cpus   = 2
    pindel_memory = '6.GB'
}
