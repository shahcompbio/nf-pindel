/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Ported from toil_pindel's tests/test_commands.py::test_pindel.

    Use as follows:
        nextflow run shahcompbio/nf-pindel -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// The bundled test data lives in the repo, but nf-schema resolves relative paths
// in a samplesheet against the launch directory, which is not the project
// directory under nf-test. Materialize a samplesheet with absolute paths so
// `-profile test` behaves identically however and wherever it is launched.
def testSamplesheet() {
    def data = "${projectDir}/tests/data"
    def sheet = new File(System.getProperty('java.io.tmpdir'), 'nf-pindel-test.csv')
    sheet.text = """\
patient,sample,status,bam,bai,bas
TEST,normal,0,${data}/normal/normal.bam,${data}/normal/normal.bam.bai,${data}/normal/normal.bam.bas
TEST,tumor,1,${data}/tumor/tumor.bam,${data}/tumor/tumor.bam.bai,${data}/tumor/tumor.bam.bas
"""
    return sheet.getAbsolutePath()
}

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal tumour/normal test dataset for cgpPindel'

    input = testSamplesheet()

    fasta = "${projectDir}/tests/data/reference/reference.fasta"
    fai   = "${projectDir}/tests/data/reference/reference.fasta.fai"

    simrep       = "${projectDir}/tests/data/pindel/simrep.bed.gz"
    genes        = "${projectDir}/tests/data/pindel/genes.bed.gz"
    unmatched    = "${projectDir}/tests/data/pindel/unmatched.vcf.gz"
    filter_rules = "${projectDir}/tests/data/pindel/filter.lst"

    species  = 'HUMAN'
    assembly = 'GRCH37D5'
    exclude  = 'NC_007605,hs37d5,GL%'

    pindel_cpus   = 2
    pindel_memory = '6.GB'
}
