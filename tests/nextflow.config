/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// The test data for this pipeline is bundled under tests/data/ rather than
// hosted on nf-core/test-datasets, so the test profile references it directly
// via ${projectDir}. See conf/test.config.
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/nf-pindel/'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
